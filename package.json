{
  "name": "cp-pilot",
  "displayName": "CP Pilot",
  "description": "Competitive programming in VS Code: import problems from Codeforces, AtCoder, CSES, USACO and 100+ judges, run tests locally, submit, and track your CSES progress.",
  "version": "0.1.0",
  "preview": true,
  "publisher": "harshraj797864",
  "author": {
    "name": "Harsh Raj"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1E3A8A",
    "theme": "dark"
  },
  "homepage": "https://github.com/HarshRaj797864/cp-pilot#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/HarshRaj797864/cp-pilot.git"
  },
  "bugs": {
    "url": "https://github.com/HarshRaj797864/cp-pilot/issues"
  },
  "qna": "https://github.com/HarshRaj797864/cp-pilot/discussions",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Testing",
    "Education",
    "Other"
  ],
  "keywords": [
    "competitive programming",
    "cp",
    "cses",
    "codeforces",
    "atcoder",
    "codechef",
    "usaco",
    "leetcode",
    "competitive companion",
    "cph",
    "test cases",
    "judge",
    "icpc",
    "olympiad",
    "submit"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Running tests executes your code, so it is disabled in untrusted workspaces."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cpPilot",
          "title": "CP Pilot",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "cpPilot": [
        {
          "type": "webview",
          "id": "cpPilot.judge",
          "name": "Judge"
        },
        {
          "id": "cpPilot.csesProblems",
          "name": "CSES Problems"
        }
      ]
    },
    "commands": [
      {
        "command": "cpPilot.runTests",
        "title": "Run Tests",
        "category": "CP Pilot",
        "icon": "$(play)"
      },
      {
        "command": "cpPilot.stopTests",
        "title": "Stop Tests",
        "category": "CP Pilot",
        "icon": "$(debug-stop)"
      },
      {
        "command": "cpPilot.restartListener",
        "title": "Restart Competitive Companion Listener",
        "category": "CP Pilot"
      },
      {
        "command": "cpPilot.submit",
        "title": "Submit Solution",
        "category": "CP Pilot",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "cpPilot.cses.login",
        "title": "Log In to CSES",
        "category": "CP Pilot"
      },
      {
        "command": "cpPilot.cses.logout",
        "title": "Log Out of CSES",
        "category": "CP Pilot"
      },
      {
        "command": "cpPilot.cses.refreshProblems",
        "title": "Refresh CSES Problems",
        "category": "CP Pilot",
        "icon": "$(refresh)"
      },
      {
        "command": "cpPilot.cses.searchProblems",
        "title": "Search CSES Problems",
        "category": "CP Pilot",
        "icon": "$(search)"
      },
      {
        "command": "cpPilot.cses.clearSearch",
        "title": "Clear CSES Search",
        "category": "CP Pilot",
        "icon": "$(clear-all)"
      },
      {
        "command": "cpPilot.cses.hideSolved",
        "title": "Hide Solved CSES Problems",
        "category": "CP Pilot",
        "icon": "$(eye-closed)"
      },
      {
        "command": "cpPilot.cses.showSolved",
        "title": "Show Solved CSES Problems",
        "category": "CP Pilot",
        "icon": "$(eye)"
      },
      {
        "command": "cpPilot.cses.openProblem",
        "title": "Open on CSES",
        "category": "CP Pilot"
      }
    ],
    "keybindings": [
      {
        "command": "cpPilot.runTests",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "cpPilot.runTests",
          "when": "resourceExtname =~ /^\\.(cpp|c|py|java|rs|go|js)$/",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "cpPilot.submit",
          "when": "cpPilot.canSubmit",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "cpPilot.cses.searchProblems",
          "when": "view == cpPilot.csesProblems",
          "group": "navigation@1"
        },
        {
          "command": "cpPilot.cses.clearSearch",
          "when": "view == cpPilot.csesProblems && cpPilot.cses.searching",
          "group": "navigation@2"
        },
        {
          "command": "cpPilot.cses.hideSolved",
          "when": "view == cpPilot.csesProblems && !cpPilot.cses.hidingSolved",
          "group": "navigation@3"
        },
        {
          "command": "cpPilot.cses.showSolved",
          "when": "view == cpPilot.csesProblems && cpPilot.cses.hidingSolved",
          "group": "navigation@3"
        },
        {
          "command": "cpPilot.cses.refreshProblems",
          "when": "view == cpPilot.csesProblems",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "cpPilot.cses.openProblem",
          "when": "false"
        },
        {
          "command": "cpPilot.cses.clearSearch",
          "when": "cpPilot.cses.searching"
        },
        {
          "command": "cpPilot.submit",
          "when": "cpPilot.canSubmit"
        },
        {
          "command": "cpPilot.cses.logout",
          "when": "cpPilot.csesLoggedIn"
        }
      ]
    },
    "configuration": {
      "title": "CP Pilot",
      "properties": {
        "cpPilot.companionPort": {
          "type": "number",
          "default": 27121,
          "minimum": 1,
          "maximum": 65535,
          "markdownDescription": "Port to receive problems from the [Competitive Companion](https://github.com/jmerle/competitive-companion) browser extension. `27121` works out of the box. If another CP extension uses it (CPH uses `27121`, CPOS `27122`), pick a free port such as `27150` and add it under *Custom ports* in Competitive Companion's settings."
        },
        "cpPilot.defaultLanguage": {
          "type": "string",
          "default": "cpp",
          "enum": [
            "cpp",
            "c",
            "python",
            "java",
            "rust",
            "go",
            "js"
          ],
          "description": "Language used for the solution file created when a problem is imported."
        },
        "cpPilot.templateFile": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a template file whose contents are copied into newly created solution files."
        },
        "cpPilot.openContestProblems": {
          "type": "string",
          "default": "all",
          "enum": [
            "all",
            "first"
          ],
          "enumDescriptions": [
            "Open a tab for every problem (A, B, C…), with the first one focused.",
            "Open only the first problem; the others are created but not opened."
          ],
          "description": "What to open when importing a whole contest from Competitive Companion."
        },
        "cpPilot.codeforces.languageIds": {
          "type": "object",
          "default": {},
          "markdownDescription": "Codeforces compiler id used for one-click submit through [cph-submit](https://github.com/agrawal-d/cph-submit), per file type. Defaults match CPH: `cpp` 91 (G++23), `c` 43, `python` 70 (PyPy 3.10), `java` 87, `rust` 98, `go` 32, `js` 55. Example: `{ \"cpp\": 89 }` for G++20. Ids are the values of the language dropdown on Codeforces' submit page.",
          "propertyNames": {
            "enum": ["cpp", "c", "python", "java", "rust", "go", "js"]
          },
          "additionalProperties": { "type": "integer" }
        },
        "cpPilot.cses.languages": {
          "type": "object",
          "default": {},
          "markdownDescription": "Language sent to CSES per file type. By default CSES picks the language from the file extension and uses its default version. Example: `{ \"python\": { \"option\": \"PyPy3\" } }`. Names and options are as shown in CSES's language dropdown.",
          "propertyNames": {
            "enum": ["cpp", "c", "python", "java", "rust", "go", "js"]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "name": { "type": ["string", "null"], "description": "Language name, e.g. \"C++\"." },
              "option": { "type": ["string", "null"], "description": "Version, e.g. \"C++17\" or \"PyPy3\"." }
            },
            "additionalProperties": false
          }
        },
        "cpPilot.languageCommands": {
          "type": "object",
          "default": {},
          "markdownDescription": "Override compile/run commands per language. Placeholders: `${file}`, `${exe}`, `${dir}`, `${stem}`. Example: `{ \"cpp\": { \"compile\": \"g++ -std=c++20 -O2 -DLOCAL -o ${exe} ${file}\" } }`",
          "propertyNames": {
            "enum": ["cpp", "c", "python", "java", "rust", "go", "js"]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "compile": { "type": "string", "description": "Compile command (omit for interpreted languages)." },
              "run": { "type": "string", "description": "Run command." }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "vsix": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
